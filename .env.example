# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://frontend-mu-eight-69.vercel.app,https://travel-sense-site.vercel.app,https://travel-sense-site-*.vercel.app

# PostgreSQL connection string (e.g. Prisma Postgres, Neon, Supabase or a local PostgreSQL)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT — use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Transactional email (SMTP / Nodemailer)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TravelSense <no-reply@example.com>
EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRES_MINUTES=30

# Image storage (Cloudinary). Optional: if left empty, admins can still add images by URL,
# but the "Upload image" button is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=travelsense

# Seed: initial administrator account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@travelsense.test
SEED_ADMIN_PASSWORD=Admin@12345
